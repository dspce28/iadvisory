# Copy to .env.local for local development. In CI these come from
# GitHub repository variables and secrets — see site/README.md.

# Google Analytics 4 measurement ID. Omit and no analytics script loads.
NEXT_PUBLIC_GA_ID=

# Endpoint receiving one JSON POST per lead (Apps Script, Formspree, CRM).
# Omit and leads go to WhatsApp only, with nothing stored.
NEXT_PUBLIC_LEAD_WEBHOOK=
